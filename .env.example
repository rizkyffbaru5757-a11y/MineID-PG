# MySQL
DATABASE_URL="mysql://user:password@localhost:3306/austinpay_gateway"

# JWT untuk auth user platform kamu sendiri
JWT_SECRET="ganti-dengan-random-string-panjang"

# Port server
PORT=4000

# --- Kredensial AustinPay (satu akun platform, dipakai untuk semua user) ---
AUSTINPAY_BASE_URL="https://austinstore.id"
AUSTINPAY_API_KEY="apg_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Opsional tapi disarankan (HMAC). Kosongkan kalau belum generate API Secret.
AUSTINPAY_API_SECRET=""

# Secret webhook yang kamu set di dashboard AustinPay > Webhook
AUSTINPAY_WEBHOOK_SECRET="webhook-secret-dari-dashboard"
